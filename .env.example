# MongoDB Connection String (Required for Production)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/admin-dashboard
# Optional fallback for DNS-restricted networks (Atlas non-SRV URI)
# Format: mongodb://<username>:<password>@host1,host2,host3/<database>?replicaSet=<rs>&ssl=true&authSource=admin
# MONGODB_DIRECT_URI=mongodb://user:pass@cluster-shard-00-00.xxxxx.mongodb.net:27017,cluster-shard-00-01.xxxxx.mongodb.net:27017,cluster-shard-00-02.xxxxx.mongodb.net:27017/admin-dashboard?replicaSet=atlas-xxxxx-shard-0&ssl=true&authSource=admin

# SMTP Configuration (Required for Emails/OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="Union Admin <no-reply@example.com>"

# Base URL (Optional but recommended for production)
# NEXT_PUBLIC_APP_URL=https://your-production-url.vercel.app
